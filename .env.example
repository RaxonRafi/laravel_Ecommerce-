APP_NAME=Goldfish
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=database
DB_PORT=3306
DB_DATABASE=goldfish
DB_USERNAME=db_user
DB_PASSWORD=password

BROADCAST_DRIVER=log
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

IMAGE_DRIVER=gd

# Admin account created by `php artisan db:seed` (AdminUserSeeder). The password
# falls back to "password" outside production; production requires it to be set.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@goldfish.test
ADMIN_PASSWORD=

# SMS gateway (registration confirmation). Leave blank to disable sending.
SMS_API_URL=
SMS_API_USERNAME=
SMS_API_PASSWORD=

# Payments. Cash on delivery works with no credentials; the online gateways stay
# hidden at checkout until they are enabled AND their credentials are filled in.
PAYMENT_GATEWAY=cod
PAYMENT_CURRENCY=BDT
PAYMENT_COD_ENABLED=true

# SSLCommerz. Sandbox and live are separate stores with separate credentials, so
# the id/password below must match whichever SSLCOMMERZ_SANDBOX selects. Register
# the IPN URL (/payment/sslcommerz/ipn) in the merchant panel — without it orders
# are only settled when a customer returns to the success page.
PAYMENT_SSLCOMMERZ_ENABLED=false
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

PAYMENT_BKASH_ENABLED=false
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_SANDBOX=true

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
# Must be a real address: Laravel refuses to send without a From header.
MAIL_FROM_ADDRESS="shop@goldfish.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
